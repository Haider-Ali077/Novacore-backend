# SuperNova backend settings. Copy to .env (git-ignored) and fill in.
# Any OpenAI-compatible chat completions endpoint works. Set the model/deployment for your provider.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
#
# Examples
#   Azure OpenAI (v1 API): LLM_BASE_URL=https://<resource>.openai.azure.com/openai/v1   LLM_MODEL=<deployment name>
#   Azure OpenAI (classic): LLM_BASE_URL=https://<resource>.openai.azure.com/openai/deployments/<deployment>?api-version=2024-10-21
#   Gemini:                 LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=gemini-2.5-flash
#   Ollama (local):         LLM_BASE_URL=http://localhost:11434/v1   LLM_API_KEY=ollama   LLM_MODEL=qwen2.5-coder:14b
#
# record = call the API and save every response to data/llm-cache (default)
# replay = never call the API, answer only from data/llm-cache (offline demo)
# auto   = use the cache when there is a hit, otherwise call and save
LLM_MODE=record
#
# abaplint syntax level (v750 ... v758, Cloud). v757 = S/4HANA 2022.
ABAP_VERSION=v757
#
# External API (/api/v1, see docs/API.md). Without SUPERNOVA_API_KEY the API stays off; the SuperNova page does not need it.
SUPERNOVA_API_KEY=
# Optional: browser origins allowed to call the API, comma-separated (for example https://office.example.com)
SUPERNOVA_API_ORIGINS=
